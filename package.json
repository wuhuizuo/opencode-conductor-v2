{
  "name": "@wuhuizuo/opencode-conductor-plugin",
  "version": "2.0.0",
  "description": "Conductor plugin for OpenCode v2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuhuizuo/opencode-conductor-v2.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "conductor",
    "agent"
  ],
  "author": "Derek Barrera",
  "contributors": [
    "wuhuizuo"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wuhuizuo/opencode-conductor-v2/issues"
  },
  "homepage": "https://github.com/wuhuizuo/opencode-conductor-v2#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/postinstall.cjs"
  ],
  "peerDependencies": {
    "@opencode/plugin": "^2.1.4"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/prompts && cp -r src/prompts/* dist/prompts/",
    "probe": "node scripts/integration-probe.mjs",
    "postinstall": "node scripts/postinstall.cjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.4",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16"
  }
}
